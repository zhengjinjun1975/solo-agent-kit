    "query": {"type": "str", "required": false, "default": null},
    "tags": {"type": "list", "required": false, "default": null},
    "source": {"type": "str", "required": false, "default": null},
    "top_k": {"type": "number", "required": false, "default": 5},
    "facts": {"type": "list", "required": false, "default": null},
    "dir": {"type": "str", "required": false, "default": null}
  },
  "outputs": {
    "stored": {"type": "dict", "desc": "写入结果", "final_hook": "stored"},
