{
  "schema_version": "agent.manifest/1.0",
  "name": "memory",
  "agent": "memory",
  "version": "0.1.0",
  "open_source": true,
  "license": "Apache-2.0",
  "entry": "main.py",
  "provides": ["memory.core"],
  "depends_on": [
    {"name": "kernels.memory_score", "reason": "检索打分纯函数"}
