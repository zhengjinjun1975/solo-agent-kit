{
  "schema_version": "agent.manifest/1.0",
  "name": "sme-decision",
  "agent": "decision",
  "version": "0.1.0",
  "open_source": true,
  "license": "Apache-2.0",
  "entry": "main.py",
  "provides": ["sme.decision"],
  "depends_on": [
    {"name": "kernels.rules", "reason": "决策规则引擎纯函数"},
    {"name": "data.cap", "reason": "可选：质量决策吃SPC结果"}
  ],
  "conflicts": [],
  "inputs": {
    "op": {"enum": ["decide", "set_thresholds", "industry"]},
    "data": {"type": "list", "required": false, "default": null},
    "rules_path": {"type": "str", "required": false, "default": null},
    "model": {"type": "dict", "required": false, "default": null},
    "industry": {"type": "str", "required": false, "default": null},
    "dir": {"type": "str", "required": false, "default": null}
  },
  "outputs": {
    "decisions": {"type": "list", "desc": "决策清单", "final_hook": "decisions"},
    "thresholds": {"type": "dict", "desc": "阈值表", "final_hook": "thresholds"}
  },
  "degraded_on_missing": [],
  "run_config": {"local_only": true}
}
