{
  "name": "solo-linkage-workflow",
  "schema": "fde.assembly/2.0",
  "version": "0.2.0",
  "description": "跨开源联动组装链（对齐 10 核心原子 + 写作原子）：monitor(采集+异常+动态阈值告警) → ontology(本体感知认知) → sme(告警→决策→行动) → fde(工单+故障诊断根因) → write(六维写作+证据核查) → delivery(交付包)。算法开源、数据不出厂，跨原子经统一能力路由协同。",
  "dir": null,
  "steps": [
    {
      "id": "ingest",
      "capability": "monitor.device",
      "op": "ingest",
      "inputs": {
        "dir": "$dir",
        "points": [
          {"device_id": "pump_01", "metric": "vibration", "value": 4.9, "ts": "2026-08-16T10:00:00"},
          {"device_id": "pump_01", "metric": "vibration", "value": 5.0, "ts": "2026-08-16T10:01:00"},
          {"device_id": "pump_01", "metric": "vibration", "value": 5.1, "ts": "2026-08-16T10:02:00"},
          {"device_id": "pump_01", "metric": "vibration", "value": 5.2, "ts": "2026-08-16T10:03:00"},
          {"device_id": "pump_01", "metric": "vibration", "value": 5.3, "ts": "2026-08-16T10:04:00"},
          {"device_id": "pump_01", "metric": "vibration", "value": 5.6, "ts": "2026-08-16T10:06:00"},
          {"device_id": "pump_01", "metric": "vibration", "value": 8.6, "ts": "2026-08-16T10:08:00"}
        ]
      }
    },
    {
      "id": "anomaly",
      "capability": "monitor.device",
      "op": "anomaly",
      "inputs": {
        "dir": "$dir",
        "values": {"$ref": "ingest.ingested.value"},
        "k": 3.0
      }
    },
    {
      "id": "adaptive",
      "capability": "monitor.device",
      "op": "adaptive",
      "inputs": {
        "dir": "$dir",
        "values": {"$ref": "ingest.ingested.value"},
        "k": 3.0
      }
    },
    {
      "id": "evaluate",
      "capability": "monitor.device",
      "op": "evaluate",
      "inputs": {
        "dir": "$dir",
        "device_id": "pump_01",
        "metric": "vibration",
        "value": 8.6
      }
    },
    {
      "id": "cognition",
      "capability": "ontology.qa",
      "op": "ask",
      "inputs": {
        "rows": [
          {"id": "pump_01", "status": "运行中", "vibration": 8.6},
          {"id": "pump_02", "status": "运行中", "vibration": 5.6}
        ],
        "question": "运行中的设备有多少条"
      }
    },
    {
      "id": "decision",
      "capability": "sme.decision",
      "op": "decide",
      "inputs": {
        "data": {"inventory": [{"product_id": "pump_01", "stock": 5, "safety_stock": 14}]},
        "industry": "factory"
      }
    },
    {
      "id": "ticket",
      "capability": "fde.task",
      "op": "issue",
      "inputs": {
        "dir": "$dir",
        "problem": "水泵 pump_01 振动 8.6 超动态阈值（异常检测命中），待诊断",
        "severity": "high"
      }
    },
    {
      "id": "learn",
      "capability": "diagnose.kb",
      "op": "add",
      "inputs": {
        "dir": "$dir",
        "problem": "水泵振动超限",
        "solution": "轴承磨损/泵轴对中不良",
        "signals": ["vibration"]
      }
    },
    {
      "id": "diagnose",
      "capability": "diagnose.kb",
      "op": "search",
      "inputs": {
        "dir": "$dir",
        "problem": "水泵振动超限",
        "top_k": 3
      }
    },
    {
      "id": "write_qa",
      "capability": "write.qa",
      "op": "scan",
      "inputs": {
        "text": "水泵振动预警已上线，振动值为8.6时自动告警并开工单，建议更换轴承并做动平衡。"
      }
    },
    {
      "id": "write_evidence",
      "capability": "write.evidence",
      "op": "fact_check",
      "inputs": {
        "text": "水泵振动预警已上线，振动值为8.6时自动告警并开工单，建议更换轴承并做动平衡。",
        "source_rows": [
          {"vibration": 8.6, "metric": "vibration", "device_id": "pump_01"},
          {"vibration": 5.6, "metric": "vibration", "device_id": "pump_02"}
        ]
      }
    },
    {
      "id": "package",
      "capability": "deliver.accept",
      "op": "package",
      "inputs": {
        "dir": "$dir",
        "monitor_snapshot": {"$ref": "ingest.ingested"},
        "tickets": [
          {"id": {"$ref": "ticket.ticket.id"},
           "state": {"$ref": "ticket.ticket.state"},
           "problem": {"$ref": "ticket.ticket.problem"},
           "diagnosis": {"$ref": "diagnose.hit.solution"}}
        ],
        "kb": "factory",
        "industry": "factory",
        "hit": 0.9,
        "questions_n": 10,
        "hits": 9
      },
      "optional": true
    }
  ],
  "final": {
    "worst_level": {"$ref": "evaluate.worst_level"},
    "accept": {"$ref": "package.accept.accept"},
    "tickets_n": {"$ref": "ticket.tickets|len"},
    "writing_evidence_pass": {"$ref": "write_evidence.pass"}
  }
}
